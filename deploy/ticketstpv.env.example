# Copiar a /etc/ticketstpv/ticketstpv.env
# Permisos recomendados: 600 root:root (systemd lo lee como root).
# No guardar este fichero con contraseña real en Git.
#
# Sustituir <SET_STRONG_PASSWORD_HERE> por la misma contraseña
# usada al crear el login ticketstpv_app en sql/04_CreateApplicationLogin.sql.
#
# No usar sa.
# No usar Integrated Security.
# No usar localhost: en este servidor hay que usar 127.0.0.1,1433.

ConnectionStrings__DbInda=Server=127.0.0.1,1433;Database=TicketsTPV;User Id=ticketstpv_app;Password=<SET_STRONG_PASSWORD_HERE>;Encrypt=True;TrustServerCertificate=True;
