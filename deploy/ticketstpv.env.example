# Copiar a /etc/ticketstpv/ticketstpv.env
# El fichero real con la contraseña queda FUERA de Git (permisos 600 root:root).
# systemd lo lee como root; no commitear /etc/ticketstpv/ticketstpv.env.
#
# Runtime (publish framework-dependent net10.0/linux-x64, no self-contained):
#   dotnet --list-runtimes
# Debe aparecer Microsoft.NETCore.App 10.x. Si no, instalar el runtime .NET 10
# ANTES de ejecutar el Worker.
#
# Sustituir <SET_STRONG_PASSWORD_HERE> por la misma contraseña usada al
# crear el login ticketstpv_app en sql/04_CreateApplicationLogin.sql.
#
# Cadena entre comillas: "User Id" contiene un espacio.
# EnvironmentFile de systemd: si la contraseña contiene comillas dobles,
# barra invertida u otros caracteres que requieran escaping, hay que
# escaparlos (p. ej. \" para una comilla dentro del valor). Evitar
# contraseñas con salto de línea.
#
# No usar sa.
# No usar Integrated Security.
# No usar localhost: en este servidor hay que usar 127.0.0.1,1433.

ConnectionStrings__DbInda="Server=127.0.0.1,1433;Database=TicketsTPV;User Id=ticketstpv_app;Password=<SET_STRONG_PASSWORD_HERE>;Encrypt=True;TrustServerCertificate=True;"

# Opcional y desactivado por defecto. No hace falta definirlo.
# La URL puede llevar un secreto: solo en este fichero, nunca en Git.
# Tracking__Alerts__WebhookEnabled=false
# Tracking__Alerts__WebhookUrl=

