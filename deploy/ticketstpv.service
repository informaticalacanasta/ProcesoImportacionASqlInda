[Unit]
Description=TicketsTPV TicketBAI XML importer
Documentation=file:/opt/TicketsTPV/app
After=network-online.target mssql-server.service
Wants=network-online.target mssql-server.service

[Service]
Type=simple
User=tpv_recepcion
Group=tpv_recepcion
WorkingDirectory=/opt/TicketsTPV/app
EnvironmentFile=/etc/ticketstpv/ticketstpv.env
Environment=DOTNET_ENVIRONMENT=Production
ExecStart=/usr/bin/dotnet /opt/TicketsTPV/app/DbInda.Worker.dll
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/tpv_recepcion

[Install]
WantedBy=multi-user.target
