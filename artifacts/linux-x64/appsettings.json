{
  "ConnectionStrings": {
    "DbInda": ""
  },
  "Paths": {
    "Input": "/opt/dbinda/entrada",
    "Processed": "/opt/dbinda/procesados",
    "Errors": "/opt/dbinda/errores",
    "Xsd": "/opt/dbinda/xsd",
    "Logs": "/opt/dbinda/logs"
  },
  "Processing": {
    "MaxConcurrency": 20,
    "QueueCapacity": 100,
    "ScanIntervalSeconds": 10,
    "StableChecks": 3,
    "StableCheckDelayMilliseconds": 1000
  },
  "Retry": {
    "InitialDelaySeconds": 5,
    "MaxDelaySeconds": 300,
    "BackoffMultiplier": 2
  },
  "XsdValidation": {
    "SchemaFileName": "tiquets.xsd"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "RetainedDays": 31
  }
}
